@using MedicalEquipmentProject.ViewModels
@model ProductViewModel

@{
    ViewData["Title"] = "Product List";
}
<h2>Danh sách sản phẩm</h2>

<!-- ✅ Form Thêm Sản Phẩm -->
<form id="product-form" enctype="multipart/form-data">
    <div>
        <label asp-for="Name"></label>
        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
    </div>
    <div>
        <label asp-for="Quantity"></label>
        @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control", type = "number" })
        @Html.ValidationMessageFor(m => m.Quantity, "", new { @class = "text-danger" })
    </div>
    <div>
        <label asp-for="Date"></label>
        @Html.TextBoxFor(m => m.Date, new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(m => m.Date, "", new { @class = "text-danger" })
    </div>
    <div>
        <label asp-for="Price"></label>
        @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number" })
        @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger" })
    </div>
    <div>
        <label asp-for="Images">Hình ảnh upload:</label>
        <input type="file" name="Images" accept="image/png, image/jpeg, image/webp" multiple class="form-control" />
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Thêm sản phẩm</button>
</form>

<hr />

<!-- ✅ Danh sách sản phẩm -->
<div id="product-list">
    <!-- Nội dung sẽ được load bằng AJAX -->
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/js/lightbox.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/css/lightbox.min.css" rel="stylesheet" />
    <script>
        function loadProducts() {
            $("#product-list").load("/Product/GetList");
        }

                function editProduct(id) {
            $.ajax({
                url: '/Product/EditProduct/' + id,
                type: 'GET',
                success: function () {
                    window.location.href = '/Product/EditProduct/' + id;
                },
                error: function (xhr) {
                    if (xhr.status === 403) {
                        Swal.fire("Lỗi", "Bạn không có quyền chỉnh sửa sản phẩm này", "error");
                    } else if (xhr.status === 404) {
                        Swal.fire("Lỗi", "Không tìm thấy sản phẩm", "error");
                    } else {
                        Swal.fire("Lỗi", "Có lỗi xảy ra khi truy cập chức năng chỉnh sửa", "error");
                    }
                }
            });
        }

                function deleteProduct(id) {
            Swal.fire({
                title: "Bạn có chắc muốn xoá?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Xoá",
                cancelButtonText: "Huỷ"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post("/Product/DeleteProduct", { id: id })
                        .done(function (response) {
                            $("#product-list").html(response);
                            Swal.fire("Đã xoá", "Sản phẩm đã được xoá thành công.", "success");
                        })
                        .fail(function (xhr) {
                            if (xhr.status === 403) {
                                Swal.fire("Lỗi", "Bạn không có quyền xoá sản phẩm này", "error");
                            } else if (xhr.status === 404) {
                                Swal.fire("Lỗi", "Sản phẩm không tồn tại", "error");
                            } else {
                                Swal.fire("Lỗi", "Không thể xoá sản phẩm.", "error");
                            }
                        });
                }
            });
        }


        $(document).ready(function () {
            loadProducts();

            $("#product-form").submit(function (e) {
                e.preventDefault();
                var formData = new FormData(this);

                $.ajax({
                    url: '/Product/AddProduct',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        $('#product-list').html(data);
                        $("#product-form")[0].reset();
                        Swal.fire("Thành công", "Đã thêm sản phẩm", "success");
                    },
                    error: function (xhr) {
                        let err = xhr.responseJSON?.errors?.join("<br>") ?? "Lỗi khi add sản phẩm";
                        Swal.fire("Lỗi", err, "error");
                    }
                });
            });
        });
    </script>
}


