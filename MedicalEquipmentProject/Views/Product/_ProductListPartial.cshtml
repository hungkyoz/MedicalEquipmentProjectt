@model List<MedicalEquipmentProject.Models.Product>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Số lượng</th>
            <th>Ngày</th>
            <th>Giá</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr id="product-@p.Id">
                <td>
    @if (p.ProductImages != null && p.ProductImages.Any())
    {
        var first = p.ProductImages.First();

        <div>
            <strong>Ảnh Local:</strong><br />
            <a href="@first.ImageUrl" data-lightbox="product-@p.Id">
                <img src="@first.ImageUrl" width="100" class="img-thumbnail" />
            </a>

            <!-- Ảnh Cloudinary -->
            @if (!string.IsNullOrEmpty(first.CloudImageUrl))
            {
                <br />
                <strong>Ảnh Cloudinary:</strong><br />
                <a href="@first.CloudImageUrl" target="_blank">
                    <img src="@first.CloudImageUrl" width="100" class="img-thumbnail" />
                </a>
            }
        </div>

        <!-- Hiển thị các ảnh khác (ẩn) -->
        @foreach (var img in p.ProductImages.Skip(1))
        {
            <!-- Lightbox local -->
            <a href="@img.ImageUrl" data-lightbox="product-@p.Id" style="display:none;"></a>

            <!-- Cloud image (ẩn hoặc xử lý nếu muốn) -->
            @if (!string.IsNullOrEmpty(img.CloudImageUrl))
            {
                <a href="@img.CloudImageUrl" target="_blank" style="display:none;"></a>
            }
        }

        <!-- Nút tải tất cả ảnh WebP -->
        <br />
        <a class="btn btn-sm btn-outline-primary mt-1" href="/Product/DownloadAllImages?productId=@p.Id">
            Tải tất cả ảnh WebP
        </a>
    }
    else
    {
        <span class="text-muted">Không có ảnh</span>
    }
</td>

                <td>@p.Name</td>
                <td>@p.Quantity</td>
                <td>@p.Date.ToString("dd/MM/yyyy")</td>
                <td>@p.Price.ToString("C")</td>
                <td>
                    <!-- Nút Sửa -->
                    <button class="btn btn-warning" onclick="editProduct(@p.Id)">Sửa</button>
                    <!-- Nút Xóa -->
                    <button class="btn btn-danger" onclick="deleteProduct(@p.Id)">Xóa</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/js/lightbox.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/css/lightbox.min.css" rel="stylesheet" />

    <script>
        function editProduct(id) {
            window.location.href = "/Product/EditProduct/" + id;
        }

        function deleteProduct(id) {
            Swal.fire({
                title: "Bạn có chắc muốn xoá?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Xoá",
                cancelButtonText: "Huỷ"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post("/Product/DeleteProduct", { id: id })
                        .done(function (response) {
                            $("#product-" + id).remove();
                            Swal.fire("Đã xoá", "Sản phẩm đã được xoá thành công.", "success");
                        })
                        .fail(function (xhr) {
                            if (xhr.status === 403) {
                                Swal.fire("Không có quyền", "Bạn không có quyền xoá sản phẩm này.", "error");
                            } else {
                                Swal.fire("Lỗi", "Không thể xoá sản phẩm.", "error");
                            }
                        });
                }
            });
        }
    </script>
}
