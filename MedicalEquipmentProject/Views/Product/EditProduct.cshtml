@using MedicalEquipmentProject.ViewModels
@model ProductViewModel

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<h2>Chỉnh sửa sản phẩm</h2>

<form id="editProductForm" enctype="multipart/form-data">
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="form-group mb-3">
        <label for="Name" class="form-label">Tên sản phẩm</label>
        <input type="text" name="Name" value="@Model.Name" class="form-control" required />
    </div>

    <div class="form-group mb-3">
        <label for="Quantity" class="form-label">Số lượng</label>
        <input type="number" name="Quantity" value="@Model.Quantity" class="form-control" required min="1" />
    </div>

    <div class="form-group mb-3">
        <label for="Date" class="form-label">Ngày</label>
        <input type="date" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" required />
    </div>

    <div class="form-group mb-3">
        <label for="Price" class="form-label">Giá</label>
        <input type="number" name="Price" value="@Model.Price" class="form-control" required min="1" step="0.01" />
    </div>

    <div class="form-group mb-3">
        <label for="Images" class="form-label">Ảnh sản phẩm (có thể chọn nhiều ảnh)</label>
        <input type="file" name="Images" class="form-control" multiple />
    </div>

    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a href="/Product/Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $('#editProductForm').submit(function (e) {
            e.preventDefault();

            var formData = new FormData(this);
            $.ajax({
                url: '/Product/EditProduct',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function () {
                    Swal.fire("Thành công", "Sản phẩm đã được cập nhật", "success")
                        .then(() => {
                            window.location.href = '/Product/Index';
                        });
                },
                error: function (xhr) {
                    let err = xhr.responseJSON?.errors?.join("<br>") ?? "Lỗi không xác định";
                    Swal.fire("Lỗi", err, "error");
                }
            });
        });
    </script>
}
