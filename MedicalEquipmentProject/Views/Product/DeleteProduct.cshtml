
@model int // id sản phẩm

<h2>Xác nhận xóa sản phẩm</h2>

<p>Bạn có chắc chắn muốn xóa sản phẩm này?</p>

<form id="delete-product-form">
    <input type="hidden" name="id" value="@Model" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a href="/Product/Index" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts {
    <script>
        $('#delete-product-form').submit(function (e) {
            e.preventDefault();
            
            var productId = $('input[name="id"]').val();
            $.ajax({
                url: '/Product/DeleteProduct',
                type: 'POST',
                data: { id: productId },
                success: function (response) {
                    Swal.fire('Đã xóa!', 'Sản phẩm đã được xóa.', 'success');
                    window.location.href = '/Product/Index'; // Redirect về trang danh sách
                },
                error: function () {
                    Swal.fire('Lỗi!', 'Có lỗi xảy ra khi xóa sản phẩm.', 'error');
                }
            });
        });
    </script>
}